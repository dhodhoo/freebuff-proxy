# freebuff-proxy configuration — minimal configuration
# Get your token using scripts/gen-token.sh or via your upstream CLI
# For full options, see .env.full-example

# Upstream auth token(s), comma-separated. Empty = bridge mode (clients bring tokens).
AUTH_TOKENS=

# Recommended: safe mode protects your accounts with anti-ban stealth (JA3 TLS, request jitter, proxy header stripping)
# This is the default; set SAFE_MODE=false to disable.
SAFE_MODE=true

# Daily message cap per token (0 = unlimited — the default).
# Unlimited is safe: the proxy locks rate-limited tokens in memory until the upstream reset
# time (07:00 UTC) and never spams the server with retries.
MAX_MESSAGES_PER_DAY=0

# Server bind address (loopback by default; containers set LISTEN_ADDR=:3457)
LISTEN_ADDR=127.0.0.1:3457

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Max additional attempts after a transient transport failure (0 disables; default 1)
TRANSIENT_RETRIES=1
