{{define "smoke_result"}}
<p class="result result-ok" role="status">Smoke test OK — <span class="mono">{{.Model}}</span> via {{.Token}} in {{.Ms}}ms.</p>
{{if .Phases}}<p class="smoke-phases">Latency: {{range $i, $p := .Phases}}{{if $i}} · {{end}}<span class="mono">{{$p.Name}}={{$p.Ms}}ms</span>{{end}}</p>{{end}}
{{if .Preview}}<pre class="smoke-preview mono">{{.Preview}}</pre>{{end}}
{{end}}
